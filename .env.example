# Copy to .env for local dev (python-dotenv loads it automatically), or set
# these as real environment variables / platform secrets in production.
# Never commit a real .env file.

# --- Database -----------------------------------------------------------
# Local default if unset: sqlite:///data/app.db (fine for dev/tests).
# In production, set this to your managed Postgres connection string, e.g.
# postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=

# --- Dashboard auth (required) ------------------------------------------
# The dashboard refuses real traffic without these in production (FLASK_ENV=production).
# Locally, if unset, it falls back to admin/changeme and prints a loud warning.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
FLASK_SECRET_KEY=

# No paid contact-enrichment provider is used by this app (ContactOut and
# SignalHire were removed by request -- see docs/INTEGRATIONS.md). There is
# nothing to configure here for contact lookup.

# --- Email sending (optional; mock provider used until Gmail is configured) ---
# See docs/INTEGRATIONS.md for the OAuth setup this requires.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- LinkedIn sign-in (optional; profile/email autofill ONLY -- NOT job
# search, messaging, or Easy Apply, which LinkedIn does not offer via
# self-serve API access). See docs/INTEGRATIONS.md for setup steps.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# --- Runtime mode ---------------------------------------------------------
# Set to "production" by the hosting platform; enables stricter checks
# (e.g. refuses to run with default dashboard credentials).
FLASK_ENV=development

# Render/Railway set PORT automatically; only needed for local testing of
# the exact prod start command.
PORT=8765
